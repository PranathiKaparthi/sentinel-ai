# Copy this file to ".env" and adjust values as needed.
# ".env" itself is git-ignored so real/local settings never get committed.

APP_NAME=SentinelAI
APP_ENV=development
LOG_LEVEL=INFO
MONITORED_DIRECTORY=../test_environment

# Optional: where the SQLite database file lives (defaults to backend/security_events.db)
# SENTINEL_DB_PATH=./security_events.db
