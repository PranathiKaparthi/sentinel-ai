# Copy this file to ".env" and adjust values as needed.
# ".env" itself is git-ignored so real/local settings never get committed.

APP_NAME=SentinelAI
APP_ENV=development
LOG_LEVEL=INFO
# Folder(s) to watch. One folder, or several separated by ";".
# Safe default: the sandbox folder in this repo.
MONITORED_DIRECTORY=../test_environment
# Real-world example on Windows (your Downloads, Desktop and Documents):
# MONITORED_DIRECTORY=C:\Users\YourName\Downloads;C:\Users\YourName\Desktop;C:\Users\YourName\Documents
# Or your whole user folder (noise below is skipped automatically):
# MONITORED_DIRECTORY=C:\Users\YourName

# Optional: what to skip, separated by ";". Folder names, or "*.ext" for file types.
# SentinelAI's own database and "folder modified" events are always skipped.
# IGNORE_PATTERNS=.git;__pycache__;.pytest_cache;node_modules;venv;.venv;AppData;$Recycle.Bin;System Volume Information;*.tmp;*.crdownload;*.part;*.partial;*.log

# Optional: where the SQLite database file lives (defaults to backend/security_events.db)
# SENTINEL_DB_PATH=./security_events.db
